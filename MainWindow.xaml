<Window x:Class="Tapete.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Tapete"
        Height="640" Width="1020" MinHeight="460" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource Bg}"
        AllowDrop="True"
        FontFamily="{DynamicResource UiFont}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Raster hinter allem. Liegt in derselben Zelle wie der Inhalt und
             ueber alle vier Zeilen, damit die Linien nicht an den Abschnitten
             abreissen. IsHitTestVisible=False, sonst schluckt es die Klicks. -->
        <Rectangle Grid.RowSpan="4" Fill="{DynamicResource Raster}" IsHitTestVisible="False" />

        <!-- Titelleiste: ziehbar -->
        <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitelZiehen">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Ellipse Width="8" Height="8" Fill="{DynamicResource Accent}" VerticalAlignment="Center" />
                <TextBlock x:Name="TitelText" Text="Tapete" Foreground="{DynamicResource Dim}" FontSize="12"
                           FontFamily="{DynamicResource TechFont}"
                           Margin="9,0,0,0" VerticalAlignment="Center" />
                <Button x:Name="SucheKnopf" Style="{StaticResource Zeile}" Content="Nach Aktualisierung suchen"
                        Click="SucheGeklickt" Margin="14,0,0,0" VerticalAlignment="Center"
                        ToolTip="Fragt bei GitHub nach, ob eine neuere Fassung vorliegt." />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,1,4,0">
                <Button Style="{StaticResource Chrome}" Content="&#xE921;" Click="Minimieren"
                        AutomationProperties.Name="Minimieren" ToolTip="Minimieren" />
                <Button Style="{StaticResource Chrome}" Content="&#xE8BB;" Click="Verstecken"
                        AutomationProperties.Name="Schließen"
                        ToolTip="Schließen (läuft im Infobereich weiter)" />
            </StackPanel>
        </Grid>

        <!-- Kopfzeile -->
        <Grid Grid.Row="1" Margin="24,6,24,18">
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <!-- Marke links vom Titel: eine kurze Leuchtlinie. Traegt den
                         technischen Ton, ohne Platz zu kosten. -->
                    <Rectangle Width="3" Height="22" Fill="{DynamicResource Accent}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{DynamicResource TitelText}" Foreground="{DynamicResource Text}"
                               FontFamily="{DynamicResource TitelFont}"
                               FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="Unterzeile" Foreground="{DynamicResource Dim}" FontSize="12.5"
                           Margin="13,4,0,0" Text="Ein Video anklicken, mehr ist nicht nötig." />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Grid Margin="0,0,8,0">
                    <TextBox x:Name="Suchfeld" Width="150" Height="30" Padding="8,0"
                             VerticalContentAlignment="Center" TextChanged="SuchfeldGeaendert"
                             Background="{DynamicResource Card}" Foreground="{DynamicResource Text}"
                             CaretBrush="{DynamicResource Accent}" BorderBrush="{DynamicResource Rand}"
                             BorderThickness="1" FontSize="12.5"
                             ToolTip="Zeigt nur Kacheln, deren Name den eingetippten Text enthält." />
                    <TextBlock x:Name="SuchePlatzhalter" Text="Suchen" IsHitTestVisible="False"
                               Foreground="{DynamicResource Dim}" FontSize="12.5"
                               VerticalAlignment="Center" Margin="9,0,0,0" />
                </Grid>
                <Button x:Name="SpielKnopf" Style="{StaticResource Ghost}" Content="Spielmodus"
                        Click="SpielmodusGeklickt" Margin="0,0,8,0"
                        ToolTip="Beendet den Abspieler ganz, nicht nur angehalten. Auch über das Symbol neben der Uhr erreichbar." />
                <Button x:Name="AusKnopf" Style="{StaticResource Ghost}" Content="Aus"
                        Click="Ausschalten" IsEnabled="False" Margin="0,0,8,0" />
                <Button Style="{StaticResource Ghost}" Content="Ordner" Click="OrdnerOeffnen" Margin="0,0,8,0"
                        ToolTip="Ordner öffnen, in dem die Videos liegen" />
                <Button Style="{StaticResource Symbolknopf}" Content="&#xE713;" Click="EinstellungenGeklickt"
                        Margin="0,0,8,0" AutomationProperties.Name="Einstellungen"
                        ToolTip="Einstellungen" />
                <Button Style="{StaticResource Primary}" Content="Video hinzufügen" Click="VideoHinzufuegen" />
            </StackPanel>
        </Grid>

        <!-- Kacheln -->
        <Grid Grid.Row="2">
            <!-- Das Effektfeld liegt hinter den Kacheln und fuellt die ganze
                 Inhaltsflaeche. Sichtbar ist es nur dort, wo keine Kachel darueber
                 liegt: rechts neben der letzten Spalte, unter der letzten Zeile
                 und beim Suchen. Ueber einem Vorschaubild also nie.
                 ClipToBounds, damit nichts in die Kopf- oder Fusszeile laeuft. -->
            <Canvas x:Name="EffektFeld" IsHitTestVisible="False" ClipToBounds="True" />

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,0,16,0"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="Liste">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Button Style="{StaticResource Kachel}" Click="KachelGeklickt"
                                        MouseRightButtonUp="KachelRechtsklick"
                                        ToolTip="{Binding Pfad}" />
                                <CheckBox Style="{StaticResource KachelHaken}"
                                          IsChecked="{Binding ImKarussell, Mode=TwoWay}"
                                          Checked="KarussellHakenGeaendert"
                                          Unchecked="KarussellHakenGeaendert"
                                          HorizontalAlignment="Left" VerticalAlignment="Top"
                                          Margin="10,10,0,0"
                                          ToolTip="Im Karussell mitlaufen lassen" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Leerer Zustand -->
            <StackPanel x:Name="Leer" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="40"
                           Foreground="#FF39404F" HorizontalAlignment="Center" />
                <TextBlock Text="Noch kein Video da" Foreground="{DynamicResource Text}" FontSize="15"
                           Margin="0,14,0,0" HorizontalAlignment="Center" />
                <TextBlock Text="MP4-Datei einfach hierher ziehen." Foreground="{DynamicResource Dim}"
                           FontSize="12.5" Margin="0,5,0,0" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Overlay beim Ziehen -->
            <Border x:Name="ZiehFlaeche" Visibility="Collapsed" Background="#CC0F1115"
                    BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="14"
                    Margin="20,0,20,10" IsHitTestVisible="False">
                <TextBlock Text="Loslassen zum Hinzufügen" Foreground="{DynamicResource Text}" FontSize="15"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>

        <!-- Fußzeile -->
        <Border Grid.Row="3" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
                Background="{DynamicResource Panel}" Padding="24,11">
            <Grid>
                <StackPanel Orientation="Horizontal" Margin="0,0,200,0">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}"
                             VerticalAlignment="Center" Margin="0,0,9,0" />
                    <TextBlock x:Name="Status" Foreground="{DynamicResource Dim}" FontSize="12"
                               FontFamily="{DynamicResource TechFont}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button x:Name="UpdateKnopf" Visibility="Collapsed" HorizontalAlignment="Right"
                        Style="{StaticResource Ghost}" Click="UpdateGeklickt"
                        ToolTip="Laedt das Setup der neuen Fassung und startet es." />
            </Grid>
        </Border>
    </Grid>
</Window>
