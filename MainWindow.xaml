<Window x:Class="Tapete.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Tapete"
        Height="640" Width="1020" MinHeight="460" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource Bg}"
        AllowDrop="True"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Titelleiste: ziehbar -->
        <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitelZiehen">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" VerticalAlignment="Center" />
                <TextBlock x:Name="TitelText" Text="Tapete" Foreground="{StaticResource Dim}" FontSize="12"
                           Margin="9,0,0,0" VerticalAlignment="Center" />
                <Button x:Name="SucheKnopf" Style="{StaticResource Zeile}" Content="Nach Aktualisierung suchen"
                        Click="SucheGeklickt" Margin="14,0,0,0" VerticalAlignment="Center"
                        ToolTip="Fragt bei GitHub nach, ob eine neuere Fassung vorliegt." />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,1,4,0">
                <Button Style="{StaticResource Chrome}" Content="&#xE921;" Click="Minimieren"
                        ToolTip="Minimieren" />
                <Button Style="{StaticResource Chrome}" Content="&#xE8BB;" Click="Verstecken"
                        ToolTip="Schließen (läuft im Infobereich weiter)" />
            </StackPanel>
        </Grid>

        <!-- Kopfzeile -->
        <Grid Grid.Row="1" Margin="24,6,24,18">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Hintergrund wählen" Foreground="{StaticResource Text}"
                           FontSize="22" FontWeight="SemiBold" />
                <TextBlock x:Name="Unterzeile" Foreground="{StaticResource Dim}" FontSize="12.5"
                           Margin="0,3,0,0" Text="Ein Video anklicken, mehr ist nicht nötig." />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="SpielKnopf" Style="{StaticResource Ghost}" Content="Spielmodus"
                        Click="SpielmodusGeklickt" Margin="0,0,8,0"
                        ToolTip="Beendet den Abspieler ganz, nicht nur angehalten. Auch über das Symbol neben der Uhr erreichbar." />
                <Button x:Name="AusKnopf" Style="{StaticResource Ghost}" Content="Aus"
                        Click="Ausschalten" IsEnabled="False" Margin="0,0,8,0" />
                <Button Style="{StaticResource Ghost}" Content="Ordner" Click="OrdnerOeffnen" Margin="0,0,8,0"
                        ToolTip="Ordner öffnen, in dem die Videos liegen" />
                <Button Style="{StaticResource Primary}" Content="Video hinzufügen" Click="VideoHinzufuegen" />
            </StackPanel>
        </Grid>

        <!-- Kacheln -->
        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,0,16,0"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="Liste">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Kachel}" Click="KachelGeklickt"
                                    MouseRightButtonUp="KachelRechtsklick"
                                    ToolTip="{Binding Pfad}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Leerer Zustand -->
            <StackPanel x:Name="Leer" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="40"
                           Foreground="#FF39404F" HorizontalAlignment="Center" />
                <TextBlock Text="Noch kein Video da" Foreground="{StaticResource Text}" FontSize="15"
                           Margin="0,14,0,0" HorizontalAlignment="Center" />
                <TextBlock Text="MP4-Datei einfach hierher ziehen." Foreground="{StaticResource Dim}"
                           FontSize="12.5" Margin="0,5,0,0" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Overlay beim Ziehen -->
            <Border x:Name="ZiehFlaeche" Visibility="Collapsed" Background="#CC0F1115"
                    BorderBrush="{StaticResource Accent}" BorderThickness="2" CornerRadius="14"
                    Margin="20,0,20,10" IsHitTestVisible="False">
                <TextBlock Text="Loslassen zum Hinzufügen" Foreground="{StaticResource Text}" FontSize="15"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>

        <!-- Fußzeile -->
        <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                Background="{StaticResource Panel}" Padding="24,11">
            <Grid>
                <TextBlock x:Name="Status" Foreground="{StaticResource Dim}" FontSize="12.5"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,570,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="UpdateKnopf" Visibility="Collapsed" Margin="0,0,18,0"
                            Style="{StaticResource Ghost}" Click="UpdateGeklickt"
                            ToolTip="Laedt das Setup der neuen Fassung und startet es." />
                    <ComboBox x:Name="BildschirmWahl" Width="190" Margin="0,0,18,0"
                              VerticalAlignment="Center"
                              SelectionChanged="BildschirmGewaehlt"
                              ToolTip="Auf welchem Bildschirm das Video laufen soll. Bei mehreren Monitoren spart die Wahl eines einzelnen auch Grafikleistung." />
                    <CheckBox x:Name="PauseSchalter" Content="Pause wenn verdeckt" Margin="0,0,18,0"
                              Checked="PauseGeaendert" Unchecked="PauseGeaendert"
                              ToolTip="Video anhalten, solange ein Fenster den Desktop verdeckt — Vollbild oder maximiert. Spart Strom und Grafikleistung." />
                    <CheckBox x:Name="BildrateSchalter" Content="Halbe Bildrate" Margin="0,0,18,0"
                              Checked="BildrateGeaendert" Unchecked="BildrateGeaendert"
                              ToolTip="Rechnet das Video einmalig auf die halbe Bildrate herunter. Spart noch einmal gut die Hälfte der Grafiklast, ist aber im Gegensatz zur Auflösung zu sehen." />
                    <CheckBox x:Name="AutostartSchalter" Content="Mit Windows starten"
                              Checked="AutostartGeaendert" Unchecked="AutostartGeaendert" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
