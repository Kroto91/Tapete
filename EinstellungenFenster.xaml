<Window x:Class="Tapete.EinstellungenFenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Einstellungen"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource Bg}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="Abschnitt" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,20,0,10" />
        </Style>
        <Style x:Key="Hinweis" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Dim}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="Zeile" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitelZiehen">
                <TextBlock Text="Einstellungen" Foreground="{StaticResource Dim}" FontSize="12"
                           Margin="18,0,0,0" VerticalAlignment="Center" />
                <Button Style="{StaticResource Chrome}" Content="&#xE8BB;" Click="Schliessen"
                        HorizontalAlignment="Right" Margin="0,1,4,0"
                        AutomationProperties.Name="Schließen" ToolTip="Schließen" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="24,0,24,8">

                <TextBlock Text="Anzeige" Style="{StaticResource Abschnitt}" Margin="0,4,0,10" />

                <Grid Style="{StaticResource Zeile}">
                    <TextBlock Text="Bildschirm" Foreground="{StaticResource Text}" FontSize="13"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="BildschirmWahl" Width="260" HorizontalAlignment="Right"
                              SelectionChanged="BildschirmGewaehlt" />
                </Grid>

                <CheckBox x:Name="BildrateSchalter" Content="Halbe Bildrate"
                          Checked="BildrateGeaendert" Unchecked="BildrateGeaendert" />
                <TextBlock Style="{StaticResource Hinweis}" Margin="0,4,0,0"
                           Text="Rechnet jedes Video einmalig auf die halbe Bildrate herunter. Spart Grafiklast, ist aber im Gegensatz zur Auflösung zu sehen." />

                <TextBlock Text="Bild und Ton" Style="{StaticResource Abschnitt}" />

                <Grid Style="{StaticResource Zeile}">
                    <TextBlock Text="Helligkeit" Foreground="{StaticResource Text}" FontSize="13"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="HelligkeitWahl" Width="180" HorizontalAlignment="Right"
                              SelectionChanged="HelligkeitGewaehlt" />
                </Grid>

                <Grid Style="{StaticResource Zeile}">
                    <TextBlock Text="Farben" Foreground="{StaticResource Text}" FontSize="13"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="SaettigungWahl" Width="180" HorizontalAlignment="Right"
                              SelectionChanged="SaettigungGewaehlt" />
                </Grid>

                <Grid Style="{StaticResource Zeile}">
                    <TextBlock Text="Geschwindigkeit" Foreground="{StaticResource Text}" FontSize="13"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="TempoWahl" Width="180" HorizontalAlignment="Right"
                              SelectionChanged="TempoGewaehlt" />
                </Grid>

                <Grid Style="{StaticResource Zeile}">
                    <TextBlock Text="Lautstärke" Foreground="{StaticResource Text}" FontSize="13"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="LautstaerkeWahl" Width="180" HorizontalAlignment="Right"
                              SelectionChanged="LautstaerkeGewaehlt" />
                </Grid>

                <TextBlock Style="{StaticResource Hinweis}" Margin="0,0,0,12"
                           Text="Ton ist ab Werk aus. Bei mehreren Bildschirmen läuft auf jedem ein eigener Abspieler, dann kommt der Ton auch mehrfach." />

                <CheckBox x:Name="HdrSchalter" Content="HDR-Ausgabe versuchen"
                          Checked="HdrGeaendert" Unchecked="HdrGeaendert" />
                <TextBlock Style="{StaticResource Hinweis}"
                           Text="Nur sinnvoll mit HDR-fähigem Bildschirm, eingeschaltetem HDR in Windows und einem Video, das selbst in HDR vorliegt. Bei einem gewöhnlichen Video bringt der Schalter nichts. Eingeschaltet schreibt der Abspieler zusätzlich mpv-hdr.txt neben das Protokoll." />

                <TextBlock Text="Strom sparen" Style="{StaticResource Abschnitt}" />

                <CheckBox x:Name="PauseSchalter" Content="Pause, wenn der Desktop verdeckt ist"
                          Checked="PauseGeaendert" Unchecked="PauseGeaendert" />
                <TextBlock Style="{StaticResource Hinweis}"
                           Text="Hält das Video an, sobald kein Stück Desktop mehr zu sehen ist. Der Abspieler läuft dabei weiter; ganz beendet wird er erst im Spielmodus, Strg+Alt+G." />

                <CheckBox x:Name="AkkuSchalter" Content="Pause im Akkubetrieb" Margin="0,10,0,0"
                          Checked="AkkuGeaendert" Unchecked="AkkuGeaendert" />
                <TextBlock Style="{StaticResource Hinweis}"
                           Text="Hält das Video an, sobald der Rechner ohne Netzstecker läuft. Auf einem Rechner ohne Akku ohne Wirkung." />

                <TextBlock Text="Karussell" Style="{StaticResource Abschnitt}" />

                <CheckBox x:Name="KarussellSchalter" Content="Hintergrund von selbst wechseln"
                          Checked="KarussellGeaendert" Unchecked="KarussellGeaendert" />

                <Grid Style="{StaticResource Zeile}" Margin="0,14,0,12">
                    <TextBlock Text="Ein Video bleibt" Foreground="{StaticResource Text}" FontSize="13"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="MinutenWahl" Width="180" HorizontalAlignment="Right"
                              SelectionChanged="MinutenGewaehlt" />
                </Grid>

                <Grid Style="{StaticResource Zeile}">
                    <TextBlock Text="Reihenfolge" Foreground="{StaticResource Text}" FontSize="13"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="ReihenfolgeWahl" Width="180" HorizontalAlignment="Right"
                              SelectionChanged="ReihenfolgeGewaehlt" />
                </Grid>

                <TextBlock x:Name="KarussellStand" Style="{StaticResource Hinweis}" Margin="0,0,0,0" />
                <TextBlock Style="{StaticResource Hinweis}"
                           Text="Welche Videos mitlaufen, entscheidet der Haken oben links auf jeder Kachel. Strg+Alt+W springt sofort zum nächsten, ebenso der Eintrag im Symbol neben der Uhr." />

                <TextBlock Text="Windows" Style="{StaticResource Abschnitt}" />

                <CheckBox x:Name="AutostartSchalter" Content="Mit Windows starten"
                          Checked="AutostartGeaendert" Unchecked="AutostartGeaendert" />
                <TextBlock Style="{StaticResource Hinweis}"
                           Text="Legt eine Verknüpfung im Autostart-Ordner an. Tapete startet dann ohne Fenster und setzt den zuletzt gewählten Hintergrund." />
            </StackPanel>

            <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                    Background="{StaticResource Panel}" Padding="24,12">
                <Button Style="{StaticResource Primary}" Content="Fertig" Click="Schliessen"
                        HorizontalAlignment="Right" />
            </Border>
        </Grid>
    </Border>
</Window>
