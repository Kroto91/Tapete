<Window x:Class="Tapete.EinstellungenFenster"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Einstellungen"
        Width="560" SizeToContent="Height"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource Bg}"
        FontFamily="{DynamicResource UiFont}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="Abschnitt" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="FontFamily" Value="{DynamicResource TechFont}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,20,0,10" />
        </Style>
        <Style x:Key="Hinweis" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Dim}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="Zeile" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource Line}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Rectangle Grid.RowSpan="3" Fill="{DynamicResource Raster}" IsHitTestVisible="False" />

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitelZiehen">
                <TextBlock Text="EINSTELLUNGEN" Foreground="{DynamicResource Dim}" FontSize="11.5"
                           FontFamily="{DynamicResource TechFont}"
                           Margin="18,0,0,0" VerticalAlignment="Center" />
                <Button Style="{StaticResource Chrome}" Content="&#xE8BB;" Click="Schliessen"
                        HorizontalAlignment="Right" Margin="0,1,4,0"
                        AutomationProperties.Name="Schließen" ToolTip="Schließen" />
            </Grid>

            <!-- Rollbereich, weil das Fenster sonst mit dem Inhalt waechst. Am
                 02.09.2026 war es rund 1230 Punkte hoch; auf einem Bildschirm mit
                 1080 Zeilen waere der Knopf "Fertig" nicht mehr erreichbar gewesen,
                 und weil das Fenster in der Groesse nicht veraenderbar ist, haette
                 daran auch niemand etwas aendern koennen. -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
            <StackPanel Margin="24,0,24,8">

                <TextBlock Text="Erscheinungsbild" Style="{StaticResource Abschnitt}" Margin="0,4,0,10" />

                <Grid Style="{StaticResource Zeile}">
                    <TextBlock Text="Aussehen" Foreground="{DynamicResource Text}" FontSize="13"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="ThemaWahl" Width="260" HorizontalAlignment="Right"
                              SelectionChanged="ThemaGewaehlt" />
                </Grid>
                <TextBlock Style="{StaticResource Hinweis}" Margin="0,0,0,10"
                           Text="Wirkt sofort, ohne Neustart. Alle vier sind auf Lesbarkeit geprüft; der Text steht in jedem mindestens im Verhältnis 4,5 zu 1 zum Hintergrund." />

                <CheckBox x:Name="EffektSchalter" Content="Zeichenregen im Hintergrund"
                          Checked="EffekteGeaendert" Unchecked="EffekteGeaendert" />
                <TextBlock Style="{StaticResource Hinweis}"
                           Text="Läuft hinter den Kacheln und ist nur in den freien Flächen zu sehen, nie über einem Vorschaubild. Jedes Aussehen hat seinen eigenen: Cyberpunk dichte Zeichen, Alarm einen ruhigen Datenstrom, HUD Nullen und Einsen, Retro grobe Blöcke." />

                <TextBlock Text="Anzeige" Style="{StaticResource Abschnitt}" />

                <Grid Style="{StaticResource Zeile}">
                    <TextBlock Text="Bildschirm" Foreground="{DynamicResource Text}" FontSize="13"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="BildschirmWahl" Width="260" HorizontalAlignment="Right"
                              SelectionChanged="BildschirmGewaehlt" />
                </Grid>

                <CheckBox x:Name="BildrateSchalter" Content="Halbe Bildrate"
                          Checked="BildrateGeaendert" Unchecked="BildrateGeaendert" />
                <TextBlock Style="{StaticResource Hinweis}" Margin="0,4,0,0"
                           Text="Rechnet jedes Video einmalig auf die halbe Bildrate herunter. Spart Grafiklast, ist aber im Gegensatz zur Auflösung zu sehen." />

                <TextBlock Text="Bild und Ton" Style="{StaticResource Abschnitt}" />

                <Grid Style="{StaticResource Zeile}">
                    <TextBlock Text="Helligkeit" Foreground="{DynamicResource Text}" FontSize="13"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="HelligkeitWahl" Width="180" HorizontalAlignment="Right"
                              SelectionChanged="HelligkeitGewaehlt" />
                </Grid>

                <Grid Style="{StaticResource Zeile}">
                    <TextBlock Text="Farben" Foreground="{DynamicResource Text}" FontSize="13"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="SaettigungWahl" Width="180" HorizontalAlignment="Right"
                              SelectionChanged="SaettigungGewaehlt" />
                </Grid>

                <Grid Style="{StaticResource Zeile}">
                    <TextBlock Text="Kontrast" Foreground="{DynamicResource Text}" FontSize="13"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="KontrastWahl" Width="180" HorizontalAlignment="Right"
                              SelectionChanged="KontrastGewaehlt" />
                </Grid>

                <Grid Style="{StaticResource Zeile}">
                    <TextBlock Text="Mitteltöne" Foreground="{DynamicResource Text}" FontSize="13"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="GammaWahl" Width="180" HorizontalAlignment="Right"
                              SelectionChanged="GammaGewaehlt" />
                </Grid>

                <Grid Style="{StaticResource Zeile}">
                    <TextBlock Text="Geschwindigkeit" Foreground="{DynamicResource Text}" FontSize="13"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="TempoWahl" Width="180" HorizontalAlignment="Right"
                              SelectionChanged="TempoGewaehlt" />
                </Grid>

                <Grid Style="{StaticResource Zeile}">
                    <TextBlock Text="Lautstärke" Foreground="{DynamicResource Text}" FontSize="13"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="LautstaerkeWahl" Width="180" HorizontalAlignment="Right"
                              SelectionChanged="LautstaerkeGewaehlt" />
                </Grid>

                <TextBlock Style="{StaticResource Hinweis}" Margin="0,0,0,12"
                           Text="Ton ist ab Werk aus. Bei mehreren Bildschirmen läuft auf jedem ein eigener Abspieler, dann kommt der Ton auch mehrfach." />

                <CheckBox x:Name="HdrSchalter" Content="HDR-Ausgabe, gewöhnliche Videos mitrechnen"
                          Checked="HdrGeaendert" Unchecked="HdrGeaendert" />
                <TextBlock Style="{StaticResource Hinweis}"
                           Text="Braucht einen HDR-fähigen Bildschirm und eingeschaltetes HDR in Windows. Liegt das Video selbst in HDR vor, wird es unverändert durchgereicht. Ein gewöhnliches Video rechnet der Abspieler beim Anzeigen auf den größeren Helligkeitsumfang hoch; das geschieht auf der Grafikkarte, es entsteht keine zweite Datei. Erfundene Helligkeit bleibt erfunden: Was die Aufnahme nie enthielt, kann auch das Umrechnen nicht zeigen. Eingeschaltet schreibt der Abspieler zusätzlich mpv-hdr.txt neben das Protokoll." />

                <TextBlock Text="Strom sparen" Style="{StaticResource Abschnitt}" />

                <CheckBox x:Name="PauseSchalter" Content="Zurückhalten, wenn der Desktop verdeckt ist"
                          Checked="PauseGeaendert" Unchecked="PauseGeaendert" />
                <TextBlock Style="{StaticResource Hinweis}"
                           Text="Hält das Video an, sobald kein Stück Desktop mehr zu sehen ist; der Abspieler läuft dabei weiter. Derselbe Haken steuert die Vollbild-Automatik: Läuft ein Spiel oder ein Film im Vollbild, schaltet Tapete zusätzlich den Spielmodus ein und beendet den Abspieler ganz. Ohne Haken passiert bei Vollbild nichts mehr, von Hand geht der Spielmodus weiter mit Strg+Alt+G." />

                <CheckBox x:Name="AkkuSchalter" Content="Pause im Akkubetrieb" Margin="0,10,0,0"
                          Checked="AkkuGeaendert" Unchecked="AkkuGeaendert" />
                <TextBlock Style="{StaticResource Hinweis}"
                           Text="Hält das Video an, sobald der Rechner ohne Netzstecker läuft. Auf einem Rechner ohne Akku ohne Wirkung." />

                <TextBlock Text="Karussell" Style="{StaticResource Abschnitt}" />

                <CheckBox x:Name="KarussellSchalter" Content="Hintergrund von selbst wechseln"
                          Checked="KarussellGeaendert" Unchecked="KarussellGeaendert" />

                <Grid Style="{StaticResource Zeile}" Margin="0,14,0,12">
                    <TextBlock Text="Ein Video bleibt" Foreground="{DynamicResource Text}" FontSize="13"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="MinutenWahl" Width="180" HorizontalAlignment="Right"
                              SelectionChanged="MinutenGewaehlt" />
                </Grid>

                <Grid Style="{StaticResource Zeile}">
                    <TextBlock Text="Reihenfolge" Foreground="{DynamicResource Text}" FontSize="13"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="ReihenfolgeWahl" Width="180" HorizontalAlignment="Right"
                              SelectionChanged="ReihenfolgeGewaehlt" />
                </Grid>

                <TextBlock x:Name="KarussellStand" Style="{StaticResource Hinweis}" Margin="0,0,0,0" />
                <TextBlock Style="{StaticResource Hinweis}"
                           Text="Welche Videos mitlaufen, entscheidet der Haken oben links auf jeder Kachel. Strg+Alt+W springt sofort zum nächsten, ebenso der Eintrag im Symbol neben der Uhr." />

                <TextBlock Text="Zeitplan" Style="{StaticResource Abschnitt}" />

                <CheckBox x:Name="ZeitplanSchalter" Content="Nach Uhrzeit wechseln"
                          Checked="ZeitplanGeaendert" Unchecked="ZeitplanGeaendert" />

                <Grid Style="{StaticResource Zeile}" Margin="0,14,0,4">
                    <TextBlock Text="Ab" Foreground="{DynamicResource Text}" FontSize="13"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ComboBox x:Name="ZeitWahl" Width="90" Margin="0,0,8,0" />
                        <ComboBox x:Name="ZeitVideoWahl" Width="240" />
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                    <Button Style="{StaticResource Ghost}" Content="Eintragen" Click="ZeitpunktEintragen"
                            Margin="0,0,8,0" />
                    <Button Style="{StaticResource Ghost}" Content="Entfernen" Click="ZeitpunktEntfernen" />
                </StackPanel>

                <TextBlock x:Name="ZeitplanStand" Style="{StaticResource Hinweis}" />
                <TextBlock Style="{StaticResource Hinweis}"
                           Text="Ein Eintrag gilt ab seiner Uhrzeit, bis der nächste greift. Der späteste Eintrag läuft über Mitternacht weiter, morgens um zwei gilt also noch der von zweiundzwanzig Uhr. Ist der Zeitplan an, ruht das Karussell." />

                <TextBlock Text="Virtuelle Desktops" Style="{StaticResource Abschnitt}" />

                <CheckBox x:Name="ProDesktopSchalter" Content="Je Desktop ein eigenes Video"
                          Checked="ProDesktopGeaendert" Unchecked="ProDesktopGeaendert" />

                <Grid Style="{StaticResource Zeile}" Margin="0,14,0,4">
                    <TextBlock Text="Auf diesem Desktop" Foreground="{DynamicResource Text}" FontSize="13"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="DesktopVideoWahl" Width="240" HorizontalAlignment="Right" />
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                    <Button Style="{StaticResource Ghost}" Content="Zuweisen" Click="DesktopZuweisen"
                            Margin="0,0,8,0" />
                    <Button Style="{StaticResource Ghost}" Content="Lösen" Click="DesktopLoesen" />
                </StackPanel>

                <TextBlock x:Name="DesktopStand" Style="{StaticResource Hinweis}" />
                <TextBlock Style="{StaticResource Hinweis}"
                           Text="Gemeint sind die Desktops, die Windows mit Strg+Windows+D anlegt und mit Strg+Windows+Pfeil wechselt. Zum Zuweisen auf den gewünschten Desktop gehen, hier ein Video wählen und auf Zuweisen klicken. Für einen Desktop ohne Zuweisung läuft das Video weiter, das gerade zu sehen ist." />

                <TextBlock Text="Profile" Style="{StaticResource Abschnitt}" />

                <Grid Style="{StaticResource Zeile}">
                    <TextBlock Text="Name" Foreground="{DynamicResource Text}" FontSize="13"
                               VerticalAlignment="Center" />
                    <ComboBox x:Name="ProfilWahl" Width="260" HorizontalAlignment="Right"
                              IsEditable="True" SelectionChanged="ProfilGewaehlt" />
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                    <Button Style="{StaticResource Ghost}" Content="Speichern" Click="ProfilSpeichern"
                            Margin="0,0,8,0" />
                    <Button Style="{StaticResource Ghost}" Content="Löschen" Click="ProfilLoeschen" />
                </StackPanel>

                <TextBlock x:Name="ProfilStand" Style="{StaticResource Hinweis}" />
                <TextBlock Style="{StaticResource Hinweis}"
                           Text="Ein Profil merkt sich den Bildschirm-Modus, das laufende Video und die per Rechtsklick vergebenen Zuweisungen. Namen eintippen und auf Speichern; aus der Liste wählen lädt es sofort." />

                <TextBlock Text="Windows" Style="{StaticResource Abschnitt}" />

                <CheckBox x:Name="AutostartSchalter" Content="Mit Windows starten"
                          Checked="AutostartGeaendert" Unchecked="AutostartGeaendert" />
                <TextBlock Style="{StaticResource Hinweis}"
                           Text="Legt eine Verknüpfung im Autostart-Ordner an. Tapete startet dann ohne Fenster und setzt den zuletzt gewählten Hintergrund." />

                <CheckBox x:Name="SchonerSchalter" Content="Als Bildschirmschoner verwenden"
                          Margin="0,10,0,0" Checked="SchonerGeaendert" Unchecked="SchonerGeaendert" />
                <TextBlock x:Name="SchonerStand" Style="{StaticResource Hinweis}" />
                <TextBlock Style="{StaticResource Hinweis}"
                           Text="Zeigt dasselbe Video im Vollbild, wenn der Rechner eine Weile unbenutzt war. Jede Taste und jede Mausbewegung beendet es wieder." />
            </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
                    Background="{DynamicResource Panel}" Padding="24,12">
                <Button Style="{StaticResource Primary}" Content="Fertig" Click="Schliessen"
                        HorizontalAlignment="Right" />
            </Border>
        </Grid>
    </Border>
</Window>
