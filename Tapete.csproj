<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- UseWindowsForms ist am 06.09.2026 herausgeflogen. Es kam allein wegen des
         Symbols im Infobereich und der Akkuabfrage herein, beides laeuft jetzt
         ueber Native.cs. WinForms sperrte zugleich das Zuschneiden beim
         Veroeffentlichen (NETSDK1175). Siehe wiki/themen/tapete.md. -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Tapete</AssemblyName>
    <RootNamespace>Tapete</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.13.78</Version>
    <Product>Tapete</Product>
    <AssemblyTitle>Tapete</AssemblyTitle>
    <Company>Tapete</Company>
    <Description>Animierter Desktop-Hintergrund</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- WFO0003: WinForms moechte die DPI-Einstellung selbst setzen. Hier fuehrt aber WPF,
         die Angabe im Manifest ist genau richtig. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>

    <!-- Sparsam laufen: ein Hintergrundprogramm braucht keine mehrfachen GC-Halden.
         Gemessen am 31.08.2026. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <EventSourceSupport>false</EventSourceSupport>

    <!-- InvariantGlobalization stand hier und ist wieder raus. Es sparte etwas
         Speicher, brachte WPF aber beim ersten Auswahlfeld zum Absturz:
         "Cannot find non-neutral culture related to 'en-us'" aus
         XmlLanguage.GetSpecificCulture(), aufgerufen vom ContentPresenter einer
         ComboBox. Die vorhandenen Schalter und Textfelder liefen nie in diesen
         Pfad, deshalb fiel es bis zum 31.08.2026 nicht auf. -->
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <!-- EnableCompressionInSingleFile bleibt bewusst aus. Am 06.09.2026 gemessen:
         Es drueckt die Datei von 147,8 auf 66,2 MB, aber der ausgelieferte
         Installer waechst dadurch von 95,2 auf 102,2 MB. Das Einzeldatei-Paket
         packt mit Deflate, Inno Setup mit lzma2; wer vorher packt, nimmt dem
         Installer die bessere Kompression weg. Siehe wiki/themen/tapete.md. -->
    <!-- MetadataUpdaterSupport, DebuggerSupport und HttpActivityPropagationSupport
         wurden am 06.09.2026 gemessen: null Ersparnis. Diese Schalter sagen dem
         Trimmer, was er wegschneiden darf, und ohne PublishTrimmed schneidet
         niemand. PublishTrimmed wiederum unterstuetzt WPF nicht.
         UseSystemResourceKeys waere ohnehin ausgeschieden: Es ersetzt
         Ausnahmetexte durch Schluessel, und an 22 Stellen landet e.Message im
         Protokoll. -->
  </PropertyGroup>

</Project>
