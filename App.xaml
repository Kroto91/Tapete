<Application x:Class="Tapete.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>

            <!-- Die Farben, Schriften und Formwerte kommen aus einem Thema unter
                 Themen/. Welches geladen ist, entscheidet die Einstellung; getauscht
                 wird zur Laufzeit, deshalb greifen die Stile unten mit DynamicResource
                 darauf zu. Mit StaticResource bliebe der zuerst geladene Wert stehen. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themen/Cyber2077.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Sichtbarer Tastaturfokus. Ohne das zeichnet WPF seinen schwarz
                 gepunkteten Standardrahmen, und der ist auf #0B0B10 unsichtbar.
                 Der Skill fuehrt "visible-focus" als Auflage fuer diesen Stil. -->
            <Style x:Key="Fokus">
                <Setter Property="Control.Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Border BorderBrush="{DynamicResource Accent}" BorderThickness="2"
                                    CornerRadius="0" Margin="-3" SnapsToDevicePixels="True" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Schlichter Knopf -->
            <Style x:Key="Ghost" TargetType="Button">
                <Setter Property="FocusVisualStyle" Value="{StaticResource Fokus}" />
                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
                <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" CornerRadius="{DynamicResource EckRadius}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- Die Rueckmeldung sitzt im Rand, nicht in der Flaeche. Auf
                                     einem so dunklen Grund kommt eine aufgehellte Flaeche nie
                                     ueber 1,6:1; ein Rand in der Akzentfarbe liegt bei 9,2:1
                                     und ist damit auch aus dem Augenwinkel zu sehen. -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource CardHover}" />
                                    <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Betonter Knopf -->
            <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Ghost}">
                <Setter Property="Foreground" Value="#FF0B0E14" />
                <Setter Property="Background" Value="{DynamicResource Accent}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" CornerRadius="{DynamicResource EckRadius}" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#FF87A1FF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Knopf, der ein Symbol statt Text traegt -->
            <Style x:Key="Symbolknopf" TargetType="Button" BasedOn="{StaticResource Ghost}">
                <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="11,7" />
            </Style>

            <!-- Haken oben links auf der Kachel: laeuft dieses Video im Karussell mit? -->
            <Style x:Key="KachelHaken" TargetType="CheckBox">
                <Setter Property="FocusVisualStyle" Value="{StaticResource Fokus}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Border x:Name="b" Width="24" Height="24" CornerRadius="0"
                                    Background="#B3000000" BorderBrush="#66FFFFFF" BorderThickness="1">
                                <!-- Unsichtbar, solange nichts angekreuzt ist. Vorher stand
                                     das Haekchen mit 25 Prozent Deckkraft immer da, und ein
                                     leerer Kasten sah aus wie ein gesetzter. Am 02.09.2026
                                     im Bildschirmfoto des Nutzers aufgefallen: Zwoelf Kacheln
                                     mit Haken, dazu die Meldung "kein Video angekreuzt". -->
                                <TextBlock x:Name="haken" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="11" Foreground="{DynamicResource Bg}"
                                           Visibility="Collapsed"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource Accent}" />
                                    <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                    <Setter TargetName="haken" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="BorderBrush" Value="White" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Kleiner Knopf fuer die Titelzeile, dort sind nur 36 Punkte Hoehe -->
            <Style x:Key="Zeile" TargetType="Button" BasedOn="{StaticResource Ghost}">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Padding" Value="10,3" />
                <Setter Property="Foreground" Value="{DynamicResource Dim}" />
            </Style>

            <!-- Fensterknopf oben rechts -->
            <Style x:Key="Chrome" TargetType="Button">
                <Setter Property="FocusVisualStyle" Value="{StaticResource Fokus}" />
                <Setter Property="Width" Value="42" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Foreground" Value="{DynamicResource Dim}" />
                <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="Transparent" CornerRadius="0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource CardHover}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Text}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Schmale Bildlaufleiste -->
            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="8" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="4" Background="#FF333947" Margin="2,0" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" />
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" />
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Kachel -->
            <Style x:Key="Kachel" TargetType="Button">
                <Setter Property="FocusVisualStyle" Value="{StaticResource Fokus}" />
                <Setter Property="Width" Value="228" />
                <Setter Property="Height" Value="140" />
                <Setter Property="Margin" Value="0,0,14,14" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="rand" CornerRadius="{DynamicResource EckRadius}" Background="{DynamicResource Card}"
                                    BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                    SnapsToDevicePixels="True">
                                <Border CornerRadius="{DynamicResource EckRadius}" ClipToBounds="True">
                                    <Grid>
                                        <Image Source="{Binding Bild}" Stretch="UniformToFill" />

                                        <!-- Platzhalter, solange kein Vorschaubild da ist -->
                                        <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                                                   Foreground="#FF3A4152"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding PlatzhalterSichtbar}" />

                                        <Border VerticalAlignment="Bottom" Height="52">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#00000000" Offset="0" />
                                                    <GradientStop Color="#E6000000" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>

                                        <!-- Dateinamen in der gleichbreiten Schrift: Sie sind
                                             technische Angaben, keine Fliesstexte, und tragen
                                             den Ton der Oberflaeche mit. -->
                                        <TextBlock Text="{Binding Name}" Foreground="White"
                                                   FontFamily="{DynamicResource TechFont}" FontSize="11.5"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Bottom" Margin="12,0,34,10" />

                                        <!-- Eckklammern. Der Skill nennt sie "decorative
                                             brackets" und fuehrt sie als Merkmal dieses Stils.
                                             Auf jeder Kachel gedaempft, an der laufenden in
                                             der Leuchtfarbe. -->
                                        <Path x:Name="klammerLO" Data="M 0,13 L 0,0 L 13,0"
                                              Stroke="{DynamicResource Dim}" StrokeThickness="1"
                                              HorizontalAlignment="Left" VerticalAlignment="Top"
                                              Margin="7,7,0,0" Opacity="{DynamicResource KlammerDeckkraft}" />
                                        <Path x:Name="klammerRU" Data="M 13,0 L 13,13 L 0,13"
                                              Stroke="{DynamicResource Dim}" StrokeThickness="1"
                                              HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                              Margin="0,0,7,7" Opacity="{DynamicResource KlammerDeckkraft}" />

                                        <!-- Punkt zeigt: laeuft gerade -->
                                        <Ellipse x:Name="punkt" Width="9" Height="9" Fill="{DynamicResource Accent}"
                                                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                 Margin="0,0,12,12" Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- 2,3:1 gegen die Kachel war zu wenig, um die Kachel unter
                                     der Maus zu erkennen. Der Rand in Akzentfarbe schafft
                                     9,4:1 und macht zugleich klar, dass die Kachel anklickbar
                                     ist. Die laufende Kachel bleibt daneben erkennbar, weil
                                     ihr Rand doppelt so dick ist und der Punkt dazukommt. -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="rand" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding Laeuft}" Value="True">
                                    <Setter TargetName="rand" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                    <Setter TargetName="rand" Property="BorderThickness" Value="2" />
                                    <Setter TargetName="punkt" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="klammerLO" Property="Stroke" Value="{DynamicResource Accent}" />
                                    <Setter TargetName="klammerLO" Property="StrokeThickness" Value="2" />
                                    <Setter TargetName="klammerLO" Property="Opacity" Value="1" />
                                    <Setter TargetName="klammerRU" Property="Stroke" Value="{DynamicResource Accent}" />
                                    <Setter TargetName="klammerRU" Property="StrokeThickness" Value="2" />
                                    <Setter TargetName="klammerRU" Property="Opacity" Value="1" />
                                    <!-- Leuchten nur hier, an genau einer Kachel. Ein Schatten je
                                         Kachel waere zwoelfmal derselbe Aufwand fuer nichts. -->
                                    <Setter TargetName="rand" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="{DynamicResource cAccent}" BlurRadius="18"
                                                              ShadowDepth="0" Opacity="0.55" />
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Schalter -->
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource Dim}" />
                <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Border x:Name="box" Width="32" Height="18" CornerRadius="9"
                                        Background="#FF2A2F3A" VerticalAlignment="Center">
                                    <Ellipse x:Name="knopf" Width="12" Height="12" Fill="#FF7A8296"
                                             HorizontalAlignment="Left" Margin="3,0,0,0" />
                                </Border>
                                <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="box" Property="Background" Value="{DynamicResource Accent}" />
                                    <Setter TargetName="knopf" Property="Fill" Value="White" />
                                    <Setter TargetName="knopf" Property="HorizontalAlignment" Value="Right" />
                                    <Setter TargetName="knopf" Property="Margin" Value="0,0,3,0" />
                                    <Setter Property="Foreground" Value="{DynamicResource Text}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
