Thumbs.db
desktop.ini
*.tmp

# Kopie der Programmdateien fuer die Weitergabe, wird bei Bedarf neu gefuellt.
weitergabe/

# Werkstattnotizen und das Reparaturskript fuer den eigenen Rechner. Am
