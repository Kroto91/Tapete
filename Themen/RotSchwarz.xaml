<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Rot auf Schwarz, die Anmutung eines Warn- und Lagesystems. Aufgebaut wie das Cyberpunk-Thema, nur mit Rot als Signalfarbe; #FF3B30 statt reinem Rot, weil reines #FF0000 auf diesem Grund nur 5,04 zu 1 schafft und damit unter der Grenze fuer Text laege. Der Rand ist #A54B4B, das reicht mit 3,56 zu 1 fuer Bedienelemente. Gewuenscht vom Nutzer am 02.09.2026. -->

    <Color x:Key="cBg">#FF0A0607</Color>
    <Color x:Key="cPanel">#FF120C0D</Color>
    <Color x:Key="cCard">#FF181011</Color>
    <Color x:Key="cCardHover">#FF241314</Color>
    <Color x:Key="cLine">#FF2E1416</Color>
    <Color x:Key="cRand">#FFA54B4B</Color>
    <Color x:Key="cText">#FFF5EDEC</Color>
    <Color x:Key="cDim">#FFB49A98</Color>
    <Color x:Key="cAccent">#FFFF3B30</Color>
    <Color x:Key="cOnAccent">#FF0A0607</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource cBg}" />
    <SolidColorBrush x:Key="Panel" Color="{StaticResource cPanel}" />
    <SolidColorBrush x:Key="Card" Color="{StaticResource cCard}" />
    <SolidColorBrush x:Key="CardHover" Color="{StaticResource cCardHover}" />
    <SolidColorBrush x:Key="Line" Color="{StaticResource cLine}" />
    <SolidColorBrush x:Key="Rand" Color="{StaticResource cRand}" />
    <SolidColorBrush x:Key="Text" Color="{StaticResource cText}" />
    <SolidColorBrush x:Key="Dim" Color="{StaticResource cDim}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource cAccent}" />
    <SolidColorBrush x:Key="OnAccent" Color="{StaticResource cOnAccent}" />

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="TechFont">Cascadia Mono, Consolas, Courier New</FontFamily>
    <FontFamily x:Key="TitelFont">Cascadia Mono, Consolas, Courier New</FontFamily>

    <CornerRadius x:Key="EckRadius">0</CornerRadius>
    <sys:Double x:Key="KlammerDeckkraft">0</sys:Double>
    <sys:Double x:Key="RandStaerke">1</sys:Double>
    <sys:String x:Key="TitelText">HINTERGRUND WÄHLEN</sys:String>

    <DrawingBrush x:Key="Raster" TileMode="Tile" Viewport="0,0,6,6"
                  ViewportUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <GeometryDrawing>
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <LineGeometry StartPoint="0,0" EndPoint="4000,0" /></GeometryGroup>
                </GeometryDrawing.Geometry>
                <GeometryDrawing.Pen>
                    <Pen Thickness="1">
                        <Pen.Brush>
                            <SolidColorBrush Color="{StaticResource cAccent}" Opacity="0.05" />
                        </Pen.Brush>
                    </Pen>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>


    <!-- Langsam sinkende Zeichenketten, spaerlicher als bei Cyberpunk: ruhiger Datenstrom statt Regen. Der Regen laeuft hinter den Kacheln und ist nur in den
         freien Flaechen zu sehen. -->
    <sys:String x:Key="EffektZeichen">0123456789ABCDEF/\|:.-=+*#</sys:String>
    <sys:Double x:Key="EffektTempo">12</sys:Double>
    <sys:Int32 x:Key="EffektDichte">16</sys:Int32>
    <sys:Double x:Key="EffektDeckkraft">0.22</sys:Double>
    <sys:Double x:Key="EffektGroesse">12</sys:Double>

</ResourceDictionary>
