<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Retro-Futurismus der Achtziger: tiefviolettes Schwarz, Neonpink, weiche Rundungen, feine Zeilen wie auf einer Bildroehre. -->

    <Color x:Key="cBg">#FF0D0716</Color>
    <Color x:Key="cPanel">#FF150C22</Color>
    <Color x:Key="cCard">#FF1C1030</Color>
    <Color x:Key="cCardHover">#FF261544</Color>
    <Color x:Key="cLine">#FF33204F</Color>
    <Color x:Key="cRand">#FF7C5BA8</Color>
    <Color x:Key="cText">#FFF5EEFF</Color>
    <Color x:Key="cDim">#FFA99BC4</Color>
    <Color x:Key="cAccent">#FFFF3D9A</Color>
    <Color x:Key="cOnAccent">#FF0D0716</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource cBg}" />
    <SolidColorBrush x:Key="Panel" Color="{StaticResource cPanel}" />
    <SolidColorBrush x:Key="Card" Color="{StaticResource cCard}" />
    <SolidColorBrush x:Key="CardHover" Color="{StaticResource cCardHover}" />
    <SolidColorBrush x:Key="Line" Color="{StaticResource cLine}" />
    <SolidColorBrush x:Key="Rand" Color="{StaticResource cRand}" />
    <SolidColorBrush x:Key="Text" Color="{StaticResource cText}" />
    <SolidColorBrush x:Key="Dim" Color="{StaticResource cDim}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource cAccent}" />
    <SolidColorBrush x:Key="OnAccent" Color="{StaticResource cOnAccent}" />

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="TechFont">Cascadia Mono, Consolas, Courier New</FontFamily>
    <FontFamily x:Key="TitelFont">Segoe UI Variable Display, Segoe UI</FontFamily>

    <CornerRadius x:Key="EckRadius">10</CornerRadius>
    <sys:Double x:Key="KlammerDeckkraft">0</sys:Double>
    <sys:Double x:Key="RandStaerke">1</sys:Double>
    <sys:String x:Key="TitelText">Hintergrund wählen</sys:String>

    <DrawingBrush x:Key="Raster" TileMode="Tile" Viewport="0,0,3,3"
                  ViewportUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <GeometryDrawing>
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <LineGeometry StartPoint="0,0" EndPoint="4000,0" /></GeometryGroup>
                </GeometryDrawing.Geometry>
                <GeometryDrawing.Pen>
                    <Pen Thickness="1">
                        <Pen.Brush>
                            <SolidColorBrush Color="{StaticResource cAccent}" Opacity="0.07" />
                        </Pen.Brush>
                    </Pen>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>


    <!-- Grobe Blockzeichen, langsam und weit auseinander: die Anmutung einer alten Bildroehre. Der Regen laeuft hinter den Kacheln und ist nur in den
         freien Flaechen zu sehen. -->
    <!-- Sonnenaufgang ueber Wasser, seit 1.13.75 -->
    <sys:String x:Key="EffektArt">sonne</sys:String>
    <sys:String x:Key="EffektZeichen">▚▞░▒▓█▌▐</sys:String>
    <sys:Double x:Key="EffektTempo">15</sys:Double>
    <sys:Int32 x:Key="EffektDichte">12</sys:Int32>
    <sys:Double x:Key="EffektDeckkraft">0.20</sys:Double>
    <sys:Double x:Key="EffektGroesse">15</sys:Double>

</ResourceDictionary>
