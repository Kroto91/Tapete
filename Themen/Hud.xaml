<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- HUD und Sci-Fi: dunkelblauer Grund, Cyan als Leuchtfarbe, feine Linien, Eckklammern, Raster. -->

    <Color x:Key="cBg">#FF0B0B10</Color>
    <Color x:Key="cPanel">#FF12141C</Color>
    <Color x:Key="cCard">#FF1A1C24</Color>
    <Color x:Key="cCardHover">#FF23262F</Color>
    <Color x:Key="cLine">#FF262A38</Color>
    <Color x:Key="cRand">#FF64748B</Color>
    <Color x:Key="cText">#FFF8FAFC</Color>
    <Color x:Key="cDim">#FF94A3B8</Color>
    <Color x:Key="cAccent">#FF38BDF8</Color>
    <Color x:Key="cOnAccent">#FF0B0B10</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource cBg}" />
    <SolidColorBrush x:Key="Panel" Color="{StaticResource cPanel}" />
    <SolidColorBrush x:Key="Card" Color="{StaticResource cCard}" />
    <SolidColorBrush x:Key="CardHover" Color="{StaticResource cCardHover}" />
    <SolidColorBrush x:Key="Line" Color="{StaticResource cLine}" />
    <SolidColorBrush x:Key="Rand" Color="{StaticResource cRand}" />
    <SolidColorBrush x:Key="Text" Color="{StaticResource cText}" />
    <SolidColorBrush x:Key="Dim" Color="{StaticResource cDim}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource cAccent}" />
    <SolidColorBrush x:Key="OnAccent" Color="{StaticResource cOnAccent}" />

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="TechFont">Cascadia Mono, Consolas, Courier New</FontFamily>
    <FontFamily x:Key="TitelFont">Cascadia Mono, Consolas, Courier New</FontFamily>

    <CornerRadius x:Key="EckRadius">0</CornerRadius>
    <sys:Double x:Key="KlammerDeckkraft">0.55</sys:Double>
    <sys:Double x:Key="RandStaerke">1</sys:Double>
    <sys:String x:Key="TitelText">HINTERGRUND WÄHLEN</sys:String>

    <DrawingBrush x:Key="Raster" TileMode="Tile" Viewport="0,0,28,28"
                  ViewportUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <GeometryDrawing>
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <LineGeometry StartPoint="0,0" EndPoint="28,0" />
                        <LineGeometry StartPoint="0,0" EndPoint="0,28" /></GeometryGroup>
                </GeometryDrawing.Geometry>
                <GeometryDrawing.Pen>
                    <Pen Thickness="1">
                        <Pen.Brush>
                            <SolidColorBrush Color="{StaticResource cAccent}" Opacity="0.06" />
                        </Pen.Brush>
                    </Pen>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>


    <!-- Dichter, schneller Strom aus Nullen und Einsen, sehr blass. Der Regen laeuft hinter den Kacheln und ist nur in den
         freien Flaechen zu sehen. -->
    <sys:String x:Key="EffektZeichen">01</sys:String>
    <sys:Double x:Key="EffektTempo">5.5</sys:Double>
    <sys:Int32 x:Key="EffektDichte">34</sys:Int32>
    <sys:Double x:Key="EffektDeckkraft">0.18</sys:Double>
    <sys:Double x:Key="EffektGroesse">11</sys:Double>

</ResourceDictionary>
